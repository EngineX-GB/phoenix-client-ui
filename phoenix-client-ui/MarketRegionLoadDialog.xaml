<Window x:Class="phoenix_prototype.MarketRegionLoadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Load Region"
        Height="450"
        Width="450"
        Background="#1A1A1A"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        BorderBrush="#333333"
        BorderThickness="1">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <!-- Label + List -->
            <RowDefinition Height="*"/>

            <!-- Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- FORM AREA -->
        <Grid Grid.Row="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- Label -->
            <Label Content="Select a region to download market data."
                   Grid.Row="0"
                   Foreground="White"
                   Margin="0,0,0,10"/>


            <!-- Scrollable List with bevelled border -->
            <Border Grid.Row="1" BorderThickness="1" BorderBrush="#555555" Background="#1A1A1A">

                <!-- Inner darker edge -->
                <Border BorderThickness="1"
        BorderBrush="#0D0D0D"
        Background="#1A1A1A">

                    <ListView x:Name="RegionListView"
              Background="#1A1A1A"
              Foreground="White"
              BorderThickness="0"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              FontSize="10">

                        <ListViewItem Content="London"
                      Padding="1"/>

                        <ListViewItem Content="South East"
                      Padding="1"/>

                        <ListViewItem Content="South West"
                      Padding="1"/>

                        <ListViewItem Content="West Midlands"
                      Padding="1"/>

                        <ListViewItem Content="East Midlands"
                      Padding="1"/>

                        <ListViewItem Content="North East"
                      Padding="1"/>

                        <ListViewItem Content="North West"
                      Padding="1"/>

                        <ListViewItem Content="East of England (Anglia)"
                      Padding="1"/>

                        <ListViewItem Content="Scotland"
                      Padding="1"/>

                        <ListViewItem Content="Wales"
                      Padding="1"/>

                        <ListViewItem Content="Northern Ireland"
                      Padding="1"/>

                        <ListViewItem Content="Channel Islands"
                      Padding="1"/>

                        <ListViewItem Content="Yorkshire And The Humber"
                      Padding="1"/>

                    </ListView>

                </Border>

            </Border>

        </Grid>


        <!-- BUTTON BAR -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="Load"
                    Width="80"
                    Margin="0,0,10,0"
                    Background="#333"
                    Foreground="White"
                    BorderBrush="#555"
                    Click="LoadRegion_Click"/>

            <Button Content="Cancel"
                    Width="80"
                    Background="#333"
                    Foreground="White"
                    BorderBrush="#555"
                    Click="Cancel_click"/>

        </StackPanel>

    </Grid>

</Window>